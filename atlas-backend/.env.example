# MongoDB Atlas
DB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/

# Flask security
SECRET_KEY=GENERATE_YOUR_OWN_SECRET_KEY

# Research Search API
SERPAPI_KEY=YOUR_SERPAPI_KEY

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/flask-api/auth/google/callback

# ORCID OAuth
ORCID_CLIENT_ID=YOUR_ORCID_CLIENT_ID
ORCID_CLIENT_SECRET=YOUR_ORCID_CLIENT_SECRET
ORCID_REDIRECT_URI=http://localhost:5000/flask-api/auth/orcid/callback

# Frontend / Backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
FRONTEND_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL
SMTP_PASS=YOUR_APP_PASSWORD
MAIL_FROM=YOUR_EMAIL

# Backend Routing
BACKEND_PUBLIC_URL=http://localhost:5000
BACKEND_PATH_PREFIX=/flask-api