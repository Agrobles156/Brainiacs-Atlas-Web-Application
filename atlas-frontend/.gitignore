# ======================================================
# FRONTEND (Next.js / Node)
# ======================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#.env*
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# ======================================================
# BACKEND (Flask / Python)
# ======================================================

# Virtual environment
.venv/
atlas-backend/.venv/
env/
venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Environment and secret files
.env
.env.*

# IDE and workspace configs
.vscode/
.idea/
*.swp

# Logs and databases
*.log
*.sqlite3
instance/

# Flask build or static outputs
*.egg-info/
dist/
build/

# ======================================================
# DOCKER / OTHER
# ======================================================

# Docker build artifacts
*.pid
*.seed
*.cover
*.tar
*.zip
*.tgz
*.bak
